{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,loading,error,not-found,template,default}.{ts,tsx}!",
    "src/auth.ts!",
    "src/auth.config.ts!",
    "src/instrumentation.ts!",
    "src/middleware.ts!",
    "src/app/sw.ts!",
    "src/scripts/checkExpiredSubscriptions.js!",
    "scripts/sync-performance-indexes.mjs!",
    "scripts/database/check-query-plans.mjs!",
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "scripts/**/*.{js,mjs,ts}",
    "tests/**/*.{ts,tsx}",
    "*.config.{js,mjs,ts}",
  ],
  "ignore": ["src/generated/**"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "nsExports": "error",
    "types": "error",
    "nsTypes": "error",
    "duplicates": "error",
    "enumMembers": "error",
    "namespaceMembers": "error",
  },
}
