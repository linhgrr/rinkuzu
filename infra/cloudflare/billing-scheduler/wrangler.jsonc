{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "rinkuzu-billing-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "TARGET_ORIGIN": "https://www.rinkuzu.app",
  },
  "secrets": {
    // Must match the Vercel BILLING_INTERNAL_HMAC_SECRET exactly.
    "required": ["BILLING_INTERNAL_HMAC_SECRET"],
  },
  "triggers": {
    // Every 15 minutes, as a safety net only (RIN-1625). A paid order becomes
    // Premium in seconds because the payment webhook drains the inbox itself
    // and /checkout settles on return; this tick catches a lost kick, an order
    // the provider never sent a webhook for, and the billing alert sweep.
    // Each tick is two Function invocations: 96 ticks x 2 = 192 a day.
    "crons": ["*/15 * * * *"],
  },
}
