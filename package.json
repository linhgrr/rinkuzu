{
  "name": "kttpm-quiz-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "npm run check:api-error-codes && npm run check:internal-api-fetch && npm run check:architecture && eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:unit": "vitest run --coverage src",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:run": "vitest run --coverage",
    "precommit:full": "npm run check:node && npm run check:install && npm run check:routes && npm run typecheck:strict && npm run format:check && npm run lint && npm run test:unit",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "analyze-component": "node scripts/analyze-component.mjs",
    "refactor-component": "node scripts/refactor-component.mjs",
    "migrate:durations": "node src/scripts/migratePlanDurations.js migrate",
    "migrate:durations:dry-run": "node src/scripts/migratePlanDurations.js dry-run",
    "cleanup:orphaned-quiz-data": "node scripts/cleanup-orphaned-quiz-data.mjs",
    "cleanup:orphaned-quiz-data:apply": "node scripts/cleanup-orphaned-quiz-data.mjs --apply",
    "migrate:remove-quiz-approval": "node scripts/remove-quiz-approval-fields.mjs",
    "migrate:remove-quiz-approval:apply": "node scripts/remove-quiz-approval-fields.mjs --apply",
    "migrate:attempt-identities": "node scripts/migrate-attempt-identities.mjs",
    "migrate:attempt-identities:apply": "node scripts/migrate-attempt-identities.mjs --apply",
    "migrate:attempt-answer-contracts": "node scripts/normalize-attempt-answer-contracts.mjs",
    "migrate:attempt-answer-contracts:apply": "node scripts/normalize-attempt-answer-contracts.mjs --apply",
    "migrate:remove-user-progress-level": "node scripts/remove-user-progress-level.mjs",
    "migrate:remove-user-progress-level:apply": "node scripts/remove-user-progress-level.mjs --apply",
    "migrate:learning-progress-contracts": "node scripts/normalize-learning-progress-contracts.mjs",
    "migrate:learning-progress-contracts:apply": "node scripts/normalize-learning-progress-contracts.mjs --apply",
    "migrate:user-contracts": "node scripts/normalize-user-contracts.mjs",
    "migrate:user-contracts:apply": "node scripts/normalize-user-contracts.mjs --apply",
    "migrate:quiz-progress-user-ids": "node scripts/normalize-quiz-progress-user-ids.mjs",
    "migrate:quiz-progress-user-ids:apply": "node scripts/normalize-quiz-progress-user-ids.mjs --apply",
    "migrate:quiz-progress-answer-contracts": "node scripts/normalize-quiz-progress-answer-contracts.mjs",
    "migrate:quiz-progress-answer-contracts:apply": "node scripts/normalize-quiz-progress-answer-contracts.mjs --apply",
    "seed:plans": "node src/scripts/seedPlansWithISO8601.js seed",
    "validate:plans": "node src/scripts/seedPlansWithISO8601.js validate",
    "check:subscriptions": "node src/scripts/checkExpiredSubscriptions.js",
    "check:node": "node -e \"const major=Number(process.versions.node.split('.')[0]); if (major < 22) { console.error('Node.js >=22 is required. Current: '+process.version); process.exit(1); }\"",
    "check:install": "npm ci --dry-run",
    "typecheck:strict": "tsc --noEmit --pretty false",
    "check:routes": "node scripts/check-route-param-safety.mjs",
    "check:internal-api-fetch": "node scripts/check-internal-api-fetch.mjs",
    "check:api-error-codes": "node scripts/check-api-error-codes.mjs",
    "check:architecture": "node scripts/check-layer-boundaries.mjs",
    "generate:adaptive-contract": "node scripts/generate-adaptive-contract.mjs",
    "check:adaptive-contract": "node scripts/check-adaptive-contract.mjs",
    "check:react-doctor": "npx -y react-doctor@latest . --yes --fail-on warning",
    "perf:fe": "bash scripts/perf-fe.sh",
    "perf:lighthouse": "node scripts/run-lighthouse.mjs",
    "check:perf-budget": "node scripts/check-perf-budget.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1078.0",
    "@aws-sdk/s3-request-presigner": "^3.1078.0",
    "@hookform/resolvers": "^5.2.2",
    "@iconify/react": "^6.0.2",
    "@next/env": "^16.2.4",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-switch": "^1.2.6",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@xyflow/react": "^12.10.1",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.2",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "argon2": "^0.40.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.35.0",
    "katex": "^0.16.33",
    "lucide-react": "^0.577.0",
    "mongoose": "^8.24.1",
    "next": "^16.2.6",
    "next-auth": "^4.24.7",
    "next-intl": "^4.11.0",
    "pdf-lib": "^1.17.1",
    "pino": "^9.14.0",
    "rate-limiter-flexible": "^8.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-dropzone": "^14.2.3",
    "react-fast-marquee": "^1.6.5",
    "react-hook-form": "^7.76.0",
    "react-hotkeys-hook": "^4.6.2",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "resend": "^6.12.3",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "swr": "^2.3.8",
    "tailwind-merge": "^2.3.0",
    "three": "^0.183.2",
    "typescript": "^5",
    "zod": "^4.3.6",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.2.6",
    "@playwright/test": "^1.59.1",
    "@redocly/cli": "^2.30.3",
    "@size-limit/preset-app": "^12.1.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/dagre": "^0.7.54",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.5.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "next-pwa": "^5.6.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.13",
    "prettier": "^3.8.3",
    "size-limit": "^12.1.0",
    "tailwindcss": "^3.4.19",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "postcss": "^8.5.13",
    "uuid": "^14.0.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.5.1"
  }
}
