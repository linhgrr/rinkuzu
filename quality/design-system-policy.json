{
  "version": 1,
  "baseline": {
    "consumer-hardcoded-color": 29,
    "arbitrary-typography": 154,
    "arbitrary-radius-shadow": 30,
    "arbitrary-layout-spacing": 125,
    "raw-neutral-border": 89,
    "standalone-raw-button": 37,
    "raw-select": 0,
    "solid-orange-dark-text": 0,
    "solid-orange-white-text": 0,
    "new-icon-family": 0
  },
  "allowedIconFamilies": ["react-icons/hi", "react-icons/hi2", "lucide-react", "@iconify/react"],
  "ruleExclusions": {
    "consumer-hardcoded-color": [
      "src/emails/**",
      "src/app/api/email/**",
      "src/lib/communication/templates.tsx",
      "src/app/**/og.png/route.tsx"
    ],
    "standalone-raw-button": ["src/components/ui/Button.tsx", "src/components/ui/ButtonBase.tsx"],
    "raw-select": ["src/components/ui/Select.tsx"]
  },
  "exceptions": [
    {
      "path": "src/features/dashboard/components/HomeDashboard.tsx",
      "ruleId": "arbitrary-layout-spacing",
      "value": "*",
      "maxOccurrences": 63,
      "kind": "optical",
      "rationale": "Fractional hero artwork bounds and positioned illustration geometry preserve the approved Figma crop and overlap.",
      "owner": "design-system"
    },
    {
      "path": "src/features/auth/components/LoginForm.tsx",
      "ruleId": "solid-orange-white-text",
      "value": "bg-landing-action font-system text-[19px] font-bold text-white",
      "maxOccurrences": 1,
      "kind": "contrast-large-text",
      "rationale": "The sign-in button label is 19px bold, which WCAG counts as large text (>= 18.66px bold); white on #ff541b is 3.21:1 and passes AA at 3:1.",
      "owner": "design-system"
    }
  ],
  "excludedPaths": ["src/features/landing/**", "src/features/auth/**"],
  "scanExcludedPaths": ["solid-orange-white-text"]
}
