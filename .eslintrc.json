{
  "extends": ["next/core-web-vitals", "plugin:jsx-a11y/recommended", "prettier"],
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint", "unused-imports", "import", "jsx-a11y"],
  "rules": {
    "@next/next/no-img-element": "error",
    "import/no-duplicates": "error",
    "no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "react-hooks/exhaustive-deps": "error",
    "unused-imports/no-unused-imports": "error",
    "@typescript-eslint/no-non-null-assertion": "error",
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "TSAsExpression[typeAnnotation.type='TSAnyKeyword'][expression.type='Identifier'][expression.name='session']",
        "message": "Do not cast 'session' to any. Session is fully typed via src/types/next-auth.d.ts — use session.user.id / session.user.role directly."
      },
      {
        "selector": "TSAsExpression[typeAnnotation.type='TSAnyKeyword'][expression.type='MemberExpression'][expression.object.name='session']",
        "message": "Do not cast 'session.X' to any. Session is fully typed via src/types/next-auth.d.ts."
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/app/api/**/route.ts"],
      "excludedFiles": [
        "src/app/api/auth/*nextauth*/route.ts",
        "src/app/api/adaptive-learning/**/route.ts",
        "src/app/api/quiz/ask-ai/route.ts"
      ],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "MemberExpression[object.name='NextResponse'][property.name='json']",
            "message": "Use apiOk() / apiErr() from '@/lib/api/response' instead of NextResponse.json so all routes share one envelope."
          },
          {
            "selector": "TSAsExpression[typeAnnotation.type='TSAnyKeyword']",
            "message": "Do not use 'as any' in API routes. Validate inputs with zod, type session via withAuth/withAdmin from '@/lib/api/auth'."
          }
        ]
      }
    },
    {
      "files": ["src/services/**/*.ts", "src/repositories/**/*.ts", "src/interfaces/**/*.ts"],
      "excludedFiles": ["**/*.test.ts", "**/*.spec.ts"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "error"
      }
    },
    {
      "files": ["src/app/api/**/route.ts"],
      "excludedFiles": ["src/lib/auth.ts", "src/lib/api/auth.ts", "src/app/api/auth/**/route.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "next-auth",
                "importNames": ["getServerSession"],
                "message": "Do not call getServerSession directly. Use withAuth/withAdmin/withOptionalAuth from '@/lib/api/auth' so role/permission checks stay centralized."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "out/",
    "coverage/",
    "public/sw.js",
    "public/workbox-*.js",
    "public/worker-*.js"
  ]
}
