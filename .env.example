# Must be a replica set. Every billing write — settlement, adjustments,
# entitlement grants and revokes — is a multi-document transaction, and those
# are only available on a replica set or mongos. A standalone mongod fails every
# one of them loudly rather than degrading, so local development needs e.g.
#   docker run -d -p 27017:27017 mongo:7 --replSet rs0
# followed by a one-off rs.initiate(). Atlas is always a replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/rinkuzu

# Generate with: openssl rand -base64 48
# Also keys the review email's unsubscribe tokens (RIN-915): rotating it
# invalidates every unsubscribe link already sent.
AUTH_SECRET=replace-me-with-at-least-32-random-chars
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Session lifetime (seconds). Default: 8h sliding, refresh after 1h.
SESSION_MAX_AGE_SECONDS=28800
SESSION_UPDATE_AGE_SECONDS=3600

# Login lockout policy
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_WINDOW_MINUTES=15
AUTH_LOCKOUT_DURATION_MINUTES=15

OBJECT_STORAGE_ENDPOINT_EXTERNAL=https://objectstorageapi.ap-southeast-1.clawcloudrun.com
# Cloudflare R2 uses `auto` (or jurisdiction codes like wnam/enam/weur/eeur/apac/oc), not AWS-style regions.
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ADDRESSING_STYLE=path
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=rinkuzu-pdfs

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
ADAPTIVE_PROXY_TIMEOUT_MS=60000
# Required in production: shared secret used by Next.js proxy → FastAPI backend.
INTERNAL_SERVICE_TOKEN=

# Transactional mail (required in production) — Resend SDK only.
MAIL_FROM=no-reply@rinkuzu.app
RESEND_API_KEY=

# Support, one-to-one feedback, marketing broadcasts, receiving webhook and worker.
SUPPORT_MAIL_FROM=RinKuzu Support <support@notify.rinkuzu.app>
SUPPORT_ADMIN_EMAIL=support@rinkuzu.app
FEEDBACK_MAIL_FROM=RinKuzu Research <research@feedback.rinkuzu.app>
FEEDBACK_REPLY_DOMAIN=reply.rinkuzu.app
MARKETING_MAIL_FROM=RinKuzu <news@news.rinkuzu.app>
MARKETING_COMPLAINT_STOP_RATE=0.001
MARKETING_HARD_BOUNCE_STOP_RATE=0.05
# Opt-in 2-day review email (RIN-915). Both unset by default.
# Comma-separated QA/ops addresses that may receive it although analytics
# exclude them (admin, test or company accounts); every other rule still applies.
# Their sends are tagged campaign=w1-review-qa and never count in admin aggregates.
REVIEW_EMAIL_QA_RECIPIENTS=
# For REVIEW_EMAIL_QA_RECIPIENTS only: minutes after the attempt instead of 48 h.
REVIEW_EMAIL_QA_DELAY_MINUTES=
# Kill switch: set to false to stop sending review emails. Unset means on.
# Held-back rows are canceled once 2 h past due, never sent late.
REVIEW_REMINDER_SENDING_ENABLED=
RESEND_WEBHOOK_SECRET=
RESEND_PRODUCT_UPDATES_TOPIC_ID=
RESEND_PROMOTIONS_TOPIC_ID=
# Vercel Cron automatically sends this value as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Read-only bearer token for GET /api/admin/stats/activation only (aggregates).
# Unset or empty disables token access; admin sessions still work.
ANALYTICS_READ_TOKEN=

# Google OAuth login (optional). Both must be set together.
# Create at https://console.cloud.google.com/ → Credentials → OAuth 2.0 Client.
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
# The merchant's checksum key, copied verbatim from the PayOS dashboard. One
# key: it signs outbound requests and verifies inbound webhooks. PayOS issues a
# single key per merchant with no overlap window, so changing it is a brief
# outage on both sides — see docs/BILLING_WEBHOOK_RUNBOOK.md.
PAYOS_CHECKSUM_KEY=
PAYOS_PROVIDER_ACCOUNT_ID=
PAYOS_CREATE_ENABLED=false
ENTITLEMENT_AUTO_ACTIVATION_ENABLED=false
EXTERNAL_REFUND_AUTO_REVOCATION_ENABLED=false
BILLING_TERMS_VERSION=2026-07-23
BILLING_QUOTE_SIGNING_KEYS=[{"kid":"v1","secret":"replace-with-at-least-32-random-characters"}]
BILLING_INTERNAL_HMAC_SECRET=replace-with-at-least-32-random-characters
# Leave empty when the Cloudflare billing scheduler drives the internal
# endpoints: its egress IP is not stable, so a non-empty list 403s every tick.
BILLING_INTERNAL_ALLOWED_IPS=
# Seals the one retained webhook body: a signature-valid payload we could not
# parse. Empty means retain no body at all. Never reuse a checksum secret here.
# Keep a retired key listed until every row it sealed has aged out.
# BILLING_WEBHOOK_PAYLOAD_KEYS=[{"kid":"v1","secret":"replace-with-at-least-32-random-characters"}]
# How long a retained body is kept, in days. Clamped to 1-90; default 30.
# BILLING_WEBHOOK_UNSUPPORTED_RETENTION_DAYS=30
# Keys the per-source webhook rate-limit bucket and the payer signal. Required
# wherever live payment traffic is accepted: `npm run check:billing` fails when
# payments are enabled and this is missing or shorter than 32 characters.
ABUSE_SIGNAL_HASH_SECRET=replace-with-at-least-32-random-characters
# Where proactive billing alerts are sent. Without it a raised alert is recorded
# and counted but never delivered, and the scheduler reports the blocker.
# BILLING_ALERT_EMAIL=
# Optional per-user billing rate-limit overrides, e.g.
# BILLING_RATE_QUOTE_USER_POINTS / BILLING_RATE_QUOTE_USER_DURATION.
# Defaults live in src/lib/billing-rate-limit.ts.
# Windows development workaround for Node 22.23.1 SRV lookups through a loopback DNS resolver.
RINKUZU_DEV_DNS_SERVERS=1.1.1.1,8.8.8.8
SUBSCRIPTION_CRON_SECRET=

# Authenticated Postiz Public API connector (server-only). Restrict the allowlist to owned channels.
POSTIZ_PUBLIC_API_URL=https://social.example.com/api/public/v1
POSTIZ_API_KEY=
POSTIZ_OWNED_INTEGRATION_IDS=

IMGBB_API_KEY=

NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_IMAGE_UNOPTIMIZED=false
