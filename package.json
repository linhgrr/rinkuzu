{
  "name": "kttpm-quiz-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "node --require ./scripts/node-dns-bootstrap.cjs ./node_modules/next/dist/bin/next dev",
    "build": "next build",
    "vercel-build": "npm run check:communications && npm run check:billing && next build",
    "build:analyze": "ANALYZE=true next build --webpack",
    "start": "node scripts/start-standalone.mjs",
    "lint": "npm run check:api-error-codes && npm run check:internal-api-fetch && npm run check:architecture && npm run check:source-of-truth && npm run check:no-nextauth-v4 && npm run check:design-system && npm run check:question-content && eslint . --max-warnings 0 --cache --cache-location .cache/eslint/",
    "typegen": "next typegen",
    "typecheck": "npm run typegen && tsc --noEmit --pretty false",
    "typecheck:hardening": "tsc --noEmit --pretty false -p tsconfig.hardening.json",
    "typecheck:declarations": "tsc --noEmit --pretty false -p tsconfig.declarations.json",
    "typecheck:scripts": "tsc --noEmit --pretty false -p tsconfig.scripts.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:unit": "vitest run --coverage",
    "test:node": "vitest run --config vitest.node.config.ts",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:quality": "vitest run --config vitest.quality.config.ts && vitest run --config vitest.quality-eslint.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "build:e2e": "node scripts/build-e2e.mjs",
    "test:e2e:local": "npm run build:e2e && playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "precommit:fast": "npm run check:node && npm run check:routes",
    "prepush:fast": "npm run typecheck && npm run typecheck:scripts && npm run lint && npm run test:node && npm run test:component",
    "prepush:full": "npm run typecheck && npm run typecheck:scripts && npm run lint && npm run test:node && npm run test:component && npm run test:integration && npm run build",
    "verify:full": "npm run check:node && npm run check:install && npm run check:routes && npm run typecheck && npm run typecheck:scripts && npm run format:check && npm run lint && npm run check:dead-code && npm run check:duplication && npm run test:quality && npm run test:unit && npm run test:integration",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "check:orphaned-quiz-data": "node scripts/cleanup-orphaned-quiz-data.mjs",
    "cleanup:orphaned-quiz-data:apply": "node scripts/delete-orphaned-quiz-data.mjs --apply",
    "cleanup:invalid-attempt-identities": "node scripts/cleanup-invalid-attempt-identities.mjs",
    "cleanup:invalid-attempt-identities:apply": "node scripts/cleanup-invalid-attempt-identities.mjs --apply",
    "migrate:canonical-quiz-question-discriminator": "node scripts/migrate-canonical-quiz-question-discriminator.mjs",
    "migrate:canonical-quiz-question-discriminator:apply": "node scripts/migrate-canonical-quiz-question-discriminator.mjs --apply",
    "migrate:user-disable-state": "node scripts/migrate-user-disable-state.mjs",
    "migrate:user-disable-state:apply": "node scripts/migrate-user-disable-state.mjs --apply",
    "migrate:user-disable-state:verify": "node scripts/migrate-user-disable-state.mjs --verify",
    "migrate:premium-quiz-catalog": "node scripts/migrate-premium-quiz-catalog.mjs",
    "migrate:premium-quiz-catalog:apply": "node scripts/migrate-premium-quiz-catalog.mjs --apply",
    "migrate:premium-quiz-catalog:verify": "node scripts/migrate-premium-quiz-catalog.mjs --verify",
    "migrate:canonical-user-emails": "node scripts/migrate-canonical-user-emails.mjs",
    "migrate:canonical-user-emails:apply": "node scripts/migrate-canonical-user-emails.mjs --apply",
    "migrate:canonical-user-emails:verify": "node scripts/migrate-canonical-user-emails.mjs --verify",
    "migrate:merge-user-email-collision": "node scripts/merge-user-email-collision.mjs",
    "migrate:active-admin-fence": "node scripts/migrate-active-admin-fence.mjs",
    "migrate:active-admin-fence:apply": "node scripts/migrate-active-admin-fence.mjs --apply",
    "migrate:active-admin-fence:verify": "node scripts/migrate-active-admin-fence.mjs --verify",
    "migrate:first-purchase-eligibility": "node scripts/migrate-first-purchase-eligibility.mjs",
    "migrate:first-purchase-eligibility:apply": "node scripts/migrate-first-purchase-eligibility.mjs --apply",
    "migrate:first-purchase-eligibility:verify": "node scripts/migrate-first-purchase-eligibility.mjs --verify",
    "migrate:single-source-cutover": "node scripts/migrate-single-source-cutover.mjs",
    "migrate:single-source-cutover:apply": "node scripts/migrate-single-source-cutover.mjs --apply --confirm-retire-legacy",
    "migrate:single-source-cutover:verify": "node scripts/migrate-single-source-cutover.mjs --verify",
    "migrate:performance-indexes": "node scripts/sync-performance-indexes.mjs --plan",
    "migrate:performance-indexes:plan": "node scripts/sync-performance-indexes.mjs --plan",
    "migrate:performance-indexes:check": "node scripts/sync-performance-indexes.mjs --check",
    "migrate:performance-indexes:apply": "node scripts/sync-performance-indexes.mjs --apply --verify",
    "migrate:performance-indexes:apply-safe": "node scripts/sync-performance-indexes.mjs --apply-safe-only",
    "migrate:performance-indexes:apply-selected": "node scripts/sync-performance-indexes.mjs --apply-selected",
    "migrate:performance-indexes:verify": "node scripts/sync-performance-indexes.mjs --verify",
    "check:database-query-plans": "node scripts/database/check-query-plans.mjs",
    "check:node": "node -e \"if (process.versions.node !== '22.23.1') { console.error('Node.js 22.23.1 is required. Current: '+process.version); process.exit(1); }\"",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "check:install": "npm ci --dry-run",
    "check:routes": "node scripts/check-route-param-safety.mjs",
    "check:internal-api-fetch": "node scripts/check-internal-api-fetch.mjs",
    "check:api-error-codes": "node scripts/check-api-error-codes.mjs",
    "check:no-nextauth-v4": "node scripts/check-no-nextauth-v4.mjs",
    "check:design-system": "node scripts/check-design-system.mjs",
    "check:question-content": "node scripts/check-question-content.mjs",
    "check:architecture": "node scripts/check-layer-boundaries.mjs",
    "check:source-of-truth": "node scripts/check-source-of-truth-architecture.mjs",
    "audit:source-of-truth": "node scripts/check-source-of-truth-architecture.mjs --report-only --json",
    "audit:consistency": "node scripts/audit-system-consistency.mjs",
    "generate:adaptive-contract": "node scripts/generate-adaptive-contract.mjs",
    "check:adaptive-contract": "node scripts/check-vendored-adaptive-contract.mjs",
    "check:adaptive-contract:live": "node scripts/check-adaptive-contract.mjs",
    "check:react-doctor": "react-doctor . --yes --scope full --json --no-telemetry --no-dead-code --no-supply-chain --blocking error",
    "check:dead-code": "knip --strict && knip --production --strict --include files,dependencies,unlisted,binaries,unresolved,cycles",
    "check:duplication": "node scripts/check-duplication.mjs",
    "check:test-integrity": "node scripts/check-test-integrity.mjs",
    "check:coverage": "node scripts/check-coverage-gates.mjs",
    "check:typecheck-hardening": "node scripts/check-typecheck-hardening.mjs",
    "check:runtime-cycles": "node scripts/check-runtime-cycles.mjs",
    "check:required-e2e-flows": "node scripts/check-required-e2e-flows.mjs",
    "check:mutation-report": "node scripts/check-mutation-report.mjs",
    "mutation:gate": "node scripts/run-mutation-gate.mjs",
    "check:database-ddl": "node scripts/check-database-ddl-boundary.mjs",
    "check:billing": "node scripts/validate-billing-infrastructure.mjs",
    "secret": "node scripts/env-secret.mjs",
    "deploy:schedulers": "node scripts/deploy-schedulers.mjs",
    "deploy:schedulers:dry-run": "node scripts/deploy-schedulers.mjs --dry-run",
    "check:communications": "node scripts/validate-communication-infrastructure.mjs",
    "check:ci-security": "node scripts/check-ci-security.mjs",
    "check:governance": "node scripts/check-repository-governance.mjs",
    "apply:governance": "node scripts/apply-repository-ruleset.mjs",
    "check:codeql-sarif": "node scripts/check-codeql-sarif.mjs",
    "check:security-audit": "node scripts/check-npm-audit.mjs",
    "test:mutation": "npm run mutation:gate -- --mode full",
    "perf:fe": "bash scripts/perf-fe.sh",
    "perf:lighthouse": "node scripts/run-lighthouse.mjs",
    "perf:size-baseline": "node scripts/create-performance-size-baseline.mjs",
    "check:perf-budget": "node scripts/check-perf-budget.mjs",
    "doctor": "react-doctor",
    "check:duplication:rebaseline": "node scripts/check-duplication.mjs --rebaseline"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
