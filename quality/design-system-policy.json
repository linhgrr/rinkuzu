{
  "version": 1,
  "baseline": {
    "consumer-hardcoded-color": 36,
    "arbitrary-typography": 175,
    "arbitrary-radius-shadow": 54,
    "arbitrary-layout-spacing": 166,
    "raw-neutral-border": 125,
    "standalone-raw-button": 42,
    "raw-select": 0,
    "solid-orange-dark-text": 0,
    "new-icon-family": 0
  },
  "allowedIconFamilies": ["react-icons/hi", "react-icons/hi2", "lucide-react", "@iconify/react"],
  "ruleExclusions": {
    "consumer-hardcoded-color": ["src/emails/**", "src/app/api/email/**"],
    "standalone-raw-button": ["src/components/ui/Button.tsx", "src/components/ui/ButtonBase.tsx"],
    "raw-select": ["src/components/ui/Select.tsx"]
  },
  "exceptions": [
    {
      "path": "src/features/dashboard/components/HomeDashboard.tsx",
      "ruleId": "arbitrary-layout-spacing",
      "value": "*",
      "maxOccurrences": 63,
      "kind": "optical",
      "rationale": "Fractional hero artwork bounds and positioned illustration geometry preserve the approved Figma crop and overlap.",
      "owner": "design-system"
    }
  ],
  "excludedPaths": ["src/features/landing/**", "src/features/auth/**"]
}
