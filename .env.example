MONGODB_URI=mongodb://127.0.0.1:27017/rinkuzu

# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-me-with-at-least-32-random-chars
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Session lifetime (seconds). Default: 8h sliding, refresh after 1h.
SESSION_MAX_AGE_SECONDS=28800
SESSION_UPDATE_AGE_SECONDS=3600

# Login lockout policy
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_WINDOW_MINUTES=15
AUTH_LOCKOUT_DURATION_MINUTES=15

OBJECT_STORAGE_ENDPOINT_EXTERNAL=https://objectstorageapi.ap-southeast-1.clawcloudrun.com
# Cloudflare R2 uses `auto` (or jurisdiction codes like wnam/enam/weur/eeur/apac/oc), not AWS-style regions.
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ADDRESSING_STYLE=path
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=rinkuzu-pdfs

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
ADAPTIVE_PROXY_TIMEOUT_MS=60000
# Required in production: shared secret used by Next.js proxy → FastAPI backend.
INTERNAL_SERVICE_TOKEN=

# Transactional mail (required in production) — Resend SDK only.
MAIL_FROM=no-reply@rinkuzu.app
RESEND_API_KEY=

# Google OAuth login (optional). Both must be set together.
# Create at https://console.cloud.google.com/ → Credentials → OAuth 2.0 Client.
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
SUBSCRIPTION_CRON_SECRET=

IMGBB_API_KEY=

NEXT_PUBLIC_GA_ID=
NEXT_IMAGE_UNOPTIMIZED=false
