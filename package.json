{
  "name": "kttpm-quiz-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next build > /dev/null && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:unit": "vitest run --coverage src",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:run": "vitest run --coverage",
    "precommit:full": "npm run format:check && npm run lint && npm run test:unit && npm run test:integration && npm run build",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "analyze-component": "node scripts/analyze-component.mjs",
    "refactor-component": "node scripts/refactor-component.mjs",
    "migrate:durations": "node src/scripts/migratePlanDurations.js migrate",
    "migrate:durations:dry-run": "node src/scripts/migratePlanDurations.js dry-run",
    "seed:plans": "node src/scripts/seedPlansWithISO8601.js seed",
    "validate:plans": "node src/scripts/seedPlansWithISO8601.js validate",
    "check:subscriptions": "node src/scripts/checkExpiredSubscriptions.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.971.0",
    "@aws-sdk/s3-request-presigner": "^3.971.0",
    "@next-auth/mongodb-adapter": "^1.1.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-dropzone": "^5.1.0",
    "@types/three": "^0.183.1",
    "@xyflow/react": "^12.10.1",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "framer-motion": "^12.35.0",
    "jsonwebtoken": "^9.0.2",
    "katex": "^0.16.33",
    "lucide-react": "^0.577.0",
    "mongoose": "^8.5.1",
    "next": "^16.2.4",
    "next-auth": "^4.24.7",
    "next-intl": "^4.11.0",
    "node-cron": "^4.2.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.3.31",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-dropzone": "^14.2.3",
    "react-icons": "^5.5.0",
    "react-katex": "^3.1.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.3.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.2",
    "sonner": "^2.0.7",
    "swr": "^2.3.8",
    "tailwind-merge": "^2.3.0",
    "three": "^0.183.2",
    "typescript": "^5",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@playwright/test": "^1.59.1",
    "@remotion/bundler": "^4.0.407",
    "@remotion/cli": "^4.0.407",
    "@remotion/google-fonts": "^4.0.407",
    "@remotion/renderer": "^4.0.407",
    "@remotion/transitions": "^4.0.407",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/dagre": "^0.7.54",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/katex": "^0.16.8",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "knip": "^6.7.0",
    "lint-staged": "^16.4.0",
    "next-pwa": "^5.6.0",
    "postcss": "^8.5.13",
    "prettier": "^3.8.3",
    "remotion": "^4.0.407",
    "tailwindcss": "^3.4.19",
    "vitest": "^4.1.5",
    "workbox-webpack-plugin": "^7.4.0"
  },
  "overrides": {
    "postcss": "^8.5.13",
    "uuid": "^14.0.0"
  }
}
