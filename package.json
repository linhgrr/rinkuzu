{
  "name": "kttpm-quiz-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build --webpack",
    "start": "node scripts/start-standalone.mjs",
    "lint": "npm run check:api-error-codes && npm run check:internal-api-fetch && npm run check:architecture && npm run check:no-nextauth-v4 && eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit --pretty false",
    "typecheck:hardening": "tsc --noEmit --pretty false -p tsconfig.hardening.json",
    "typecheck:declarations": "tsc --noEmit --pretty false -p tsconfig.declarations.json",
    "typecheck:scripts": "tsc --noEmit --pretty false -p tsconfig.scripts.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:unit": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "test:run": "vitest run --coverage",
    "precommit:full": "npm run check:node && npm run check:install && npm run check:routes && npm run typecheck:strict && npm run format:check && npm run lint && npm run check:duplication && npm run test:unit",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "analyze-component": "node scripts/analyze-component.mjs",
    "refactor-component": "node scripts/refactor-component.mjs",
    "check:orphaned-quiz-data": "node scripts/cleanup-orphaned-quiz-data.mjs",
    "cleanup:invalid-attempt-identities": "node scripts/cleanup-invalid-attempt-identities.mjs",
    "cleanup:invalid-attempt-identities:apply": "node scripts/cleanup-invalid-attempt-identities.mjs --apply",
    "migrate:canonical-quiz-question-discriminator": "node scripts/migrate-canonical-quiz-question-discriminator.mjs",
    "migrate:canonical-quiz-question-discriminator:apply": "node scripts/migrate-canonical-quiz-question-discriminator.mjs --apply",
    "migrate:performance-indexes": "node scripts/sync-performance-indexes.mjs --plan",
    "migrate:performance-indexes:plan": "node scripts/sync-performance-indexes.mjs --plan",
    "migrate:performance-indexes:check": "node scripts/sync-performance-indexes.mjs --check",
    "migrate:performance-indexes:apply": "node scripts/sync-performance-indexes.mjs --apply --verify",
    "migrate:performance-indexes:apply-safe": "node scripts/sync-performance-indexes.mjs --apply-safe-only",
    "migrate:performance-indexes:apply-selected": "node scripts/sync-performance-indexes.mjs --apply-selected",
    "migrate:performance-indexes:verify": "node scripts/sync-performance-indexes.mjs --verify",
    "check:database-query-plans": "node scripts/database/check-query-plans.mjs",
    "check:subscriptions": "node src/scripts/checkExpiredSubscriptions.js",
    "check:node": "node -e \"if (process.versions.node !== '22.23.1') { console.error('Node.js 22.23.1 is required. Current: '+process.version); process.exit(1); }\"",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "check:install": "npm ci --dry-run",
    "typecheck:strict": "tsc --noEmit --pretty false",
    "check:routes": "node scripts/check-route-param-safety.mjs",
    "check:internal-api-fetch": "node scripts/check-internal-api-fetch.mjs",
    "check:api-error-codes": "node scripts/check-api-error-codes.mjs",
    "check:no-nextauth-v4": "node scripts/check-no-nextauth-v4.mjs",
    "check:architecture": "node scripts/check-layer-boundaries.mjs",
    "generate:adaptive-contract": "node scripts/generate-adaptive-contract.mjs",
    "check:adaptive-contract": "node scripts/check-vendored-adaptive-contract.mjs",
    "check:adaptive-contract:live": "node scripts/check-adaptive-contract.mjs",
    "check:react-doctor": "react-doctor . --yes --scope full --json --no-telemetry --no-dead-code --no-supply-chain --blocking error",
    "check:dead-code": "knip --production --strict --include files,dependencies,unlisted,binaries,unresolved,cycles",
    "check:dead-code:full": "knip",
    "check:dead-code:exports": "knip --production --strict --include exports,nsExports,types,nsTypes,enumMembers,namespaceMembers,duplicates",
    "check:duplication": "node scripts/check-duplication.mjs",
    "check:test-integrity": "node scripts/check-test-integrity.mjs",
    "check:coverage": "node scripts/check-coverage-gates.mjs",
    "check:runtime-cycles": "node scripts/check-runtime-cycles.mjs",
    "check:required-e2e-flows": "node scripts/check-required-e2e-flows.mjs",
    "check:e2e-inventory": "node scripts/check-required-e2e-flows.mjs",
    "check:mutation": "node scripts/check-mutation-report.mjs",
    "check:mutation-report": "node scripts/check-mutation-report.mjs",
    "mutation:gate": "node scripts/run-mutation-gate.mjs",
    "check:database-ddl": "node scripts/check-database-ddl-boundary.mjs",
    "check:ci-security": "node scripts/check-ci-security.mjs",
    "check:governance": "node scripts/check-repository-governance.mjs",
    "apply:governance": "node scripts/apply-repository-ruleset.mjs",
    "check:security-audit": "node scripts/check-npm-audit.mjs",
    "test:mutation": "npm run mutation:gate -- --mode full",
    "perf:fe": "bash scripts/perf-fe.sh",
    "perf:lighthouse": "node scripts/run-lighthouse.mjs",
    "perf:size-baseline": "node scripts/create-performance-size-baseline.mjs",
    "check:perf-budget": "node scripts/check-perf-budget.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@auth/core": "0.41.2",
    "@aws-sdk/client-s3": "^3.1078.0",
    "@aws-sdk/s3-request-presigner": "^3.1078.0",
    "@hookform/resolvers": "^5.2.2",
    "@iconify/react": "^6.0.2",
    "@next/env": "16.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@serwist/turbopack": "9.5.11",
    "@xyflow/react": "^12.10.1",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.2",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "argon2": "^0.40.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "dotenv": "17.4.2",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "esbuild": "0.28.1",
    "framer-motion": "^12.35.0",
    "katex": "^0.16.33",
    "lucide-react": "^0.577.0",
    "mongodb": "6.20.0",
    "mongoose": "^8.24.1",
    "next": "16.2.10",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "^4.11.0",
    "pdf-lib": "^1.17.1",
    "pino": "^9.14.0",
    "rate-limiter-flexible": "^8.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-dropzone": "^14.2.3",
    "react-fast-marquee": "^1.6.5",
    "react-hook-form": "^7.76.0",
    "react-hotkeys-hook": "^4.6.2",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "resend": "^6.12.3",
    "server-only": "^0.0.1",
    "serwist": "9.5.11",
    "sonner": "^2.0.7",
    "swr": "^2.3.8",
    "tailwind-merge": "^2.3.0",
    "zod": "^4.3.6",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "16.2.10",
    "@playwright/test": "1.61.1",
    "@redocly/cli": "^2.30.3",
    "@size-limit/preset-app": "^12.1.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/dagre": "^0.7.54",
    "@types/jest-axe": "3.5.9",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitest/coverage-v8": "4.1.5",
    "autoprefixer": "^10.5.0",
    "axe-core": "4.12.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jest-axe": "10.0.0",
    "jscpd": "5.0.12",
    "jsdom": "29.1.1",
    "knip": "6.26.0",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.13",
    "prettier": "^3.8.3",
    "react-doctor": "0.7.8",
    "size-limit": "^12.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vitest": "4.1.5"
  },
  "overrides": {
    "postcss": "^8.5.13",
    "qs": "6.15.3",
    "tmp": "0.2.7",
    "uuid": "^14.0.0"
  },
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  }
}
