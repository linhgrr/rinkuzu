{
  "ignore": {
    "rules": [
      "react-doctor/no-adjust-state-on-prop-change",
      "react-doctor/no-derived-state",
      "react-doctor/no-event-handler",
      "react-doctor/async-defer-await",
      "react-doctor/no-pass-data-to-parent",
      "react-doctor/exhaustive-deps",
      "react-doctor/no-chain-state-updates",
      "react-doctor/no-reset-all-state-on-prop-change",
      "react-doctor/prefer-use-sync-external-store",
      "react-doctor/require-pnpm-hardening",
      "react-doctor/no-giant-component",
      "react-doctor/js-length-check-first"
    ],
    "overrides": [
      {
        "files": ["package.json"],
        "rules": ["deslop/unused-dev-dependency"]
      },
      {
        "files": ["src/components/adaptive/ConceptDetail.tsx"],
        "rules": ["react-doctor/prefer-tag-over-role"]
      },
      {
        "files": ["src/hooks/usePdfProcessor.ts"],
        "rules": ["react-doctor/async-await-in-loop"]
      },
      {
        "files": [
          "src/repositories/AdminBillingRepository.ts",
          "src/repositories/SubscriptionRepository.ts"
        ],
        "rules": ["react-doctor/server-sequential-independent-await"]
      }
    ]
  }
}
