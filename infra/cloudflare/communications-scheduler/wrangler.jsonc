{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "rinkuzu-communications-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "TARGET_URL": "https://www.rinkuzu.app/api/internal/communications/worker",
  },
  "secrets": {
    "required": ["CRON_SECRET"],
  },
  "triggers": {
    // Every 15 minutes: 96 Function invocations a day (RIN-1625). Verification,
    // reset and password-changed mail is sent inline by the auth request, not
    // through this queue, so signup mail does not wait on this tick. What does:
    // activation nudges, feedback invitations, campaigns and retention, none of
    // which is minute-sensitive.
    "crons": ["*/15 * * * *"],
  },
}
